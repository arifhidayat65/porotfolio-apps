# EmailJS configuration for the contact form (https://dashboard.emailjs.com)
# 1. Create a free EmailJS account, add an email service and a template.
# 2. Template variables used by the form: {{from_name}}, {{from_email}}, {{message}}, {{to_email}}
# 3. Set the template "To email" to arifhidayat1010@gmail.com (or use {{to_email}})
# Without these keys, the contact form gracefully falls back to opening the
# visitor's email client (mailto) instead of sending — it never fakes success.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
